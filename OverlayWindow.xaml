<Window x:Class="CS2Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Width="370"
        Height="250"
        MinWidth="240"
        MinHeight="180"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Opacity="0">

    <!-- 🔹 RESOURCES -->
    <Window.Resources>
        <!-- Font Sizes -->
        <sys:Double x:Key="fs.title">18</sys:Double>
        <sys:Double x:Key="fs.score">28</sys:Double>
        <sys:Double x:Key="fs.body">13</sys:Double>

        <!-- Theme Colors -->
        <SolidColorBrush x:Key="Brush.Panel" Color="#161B24"/>
        <SolidColorBrush x:Key="Brush.Border" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Brush.Blue" Color="#7CC2FF"/>
        <SolidColorBrush x:Key="Brush.Orange" Color="#FFA870"/>
        <SolidColorBrush x:Key="Brush.MidText" Color="#AAFFFFFF"/>

        <!-- Toolbar Buttons -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E232C"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#28303C"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#16202C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 🔹 MAIN CONTENT -->
    <Border x:Name="RootBorder"
            CornerRadius="12"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            Background="{StaticResource Brush.Panel}"
            Padding="10"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header / Scoreboard -->
                <RowDefinition Height="*"/>     <!-- Body -->
            </Grid.RowDefinitions>

            <!-- 🟦 HEADER SCOREBOARD -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="4,0,4,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SbTeam1"
                               Text="TEAM A"
                               Foreground="{StaticResource Brush.Blue}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource fs.title}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" " Width="4"/>
                    <TextBlock x:Name="SbScore1"
                               Text="2"
                               FontWeight="Black"
                               FontSize="{DynamicResource fs.score}"
                               Foreground="White"/>
                    <TextBlock Text=" : "
                               FontSize="{DynamicResource fs.score}"
                               Foreground="{StaticResource Brush.MidText}"/>
                    <TextBlock x:Name="SbScore2"
                               Text="5"
                               FontWeight="Black"
                               FontSize="{DynamicResource fs.score}"
                               Foreground="White"/>
                    <TextBlock Text=" " Width="4"/>
                    <TextBlock x:Name="SbTeam2"
                               Text="TEAM B"
                               Foreground="{StaticResource Brush.Orange}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource fs.title}"/>
                </StackPanel>

                <!-- Toolbar Buttons -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="DockButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="🔒"
                            ToolTip="Lock/Unlock Overlay"
                            Margin="4,0,0,0"
                            Click="DockButton_Click"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="×"
                            ToolTip="Close Overlay"
                            Margin="4,0,0,0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- 🟧 BODY -->
            <StackPanel Grid.Row="1"
                        Margin="6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
            >

                <!-- Time + Map -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock x:Name="SbTime"
                               Text="1:25"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SbMap"
                               Text="INFERNO"
                               FontSize="13"
                               Foreground="{StaticResource Brush.MidText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Win Probability -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="WIN PROBABILITY"
                               FontSize="12"
                               Foreground="{StaticResource Brush.MidText}"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                        <TextBlock x:Name="WpTeam1Pct"
                                   Text="30%"
                                   Foreground="{StaticResource Brush.Blue}"
                                   FontWeight="Bold"
                                   FontSize="22"/>
                        <TextBlock Text="/"
                                   Foreground="{StaticResource Brush.MidText}"
                                   FontSize="18"
                                   Margin="8,0,8,0"/>
                        <TextBlock x:Name="WpTeam2Pct"
                                   Text="70%"
                                   Foreground="{StaticResource Brush.Orange}"
                                   FontWeight="Bold"
                                   FontSize="22"/>
                    </StackPanel>
                    <ProgressBar x:Name="WpBarTeam1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="30"
                                 Height="8"
                                 Foreground="{StaticResource Brush.Blue}"
                                 Background="#222"
                                 Margin="0,4,0,2"/>
                    <ProgressBar x:Name="WpBarTeam2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="70"
                                 Height="8"
                                 Foreground="{StaticResource Brush.Orange}"
                                 Background="#222"/>
                </StackPanel>

                <!-- Killfeed -->
                <ListBox x:Name="KillFeed"
                         Width="340"
                         Height="60"
                         Background="#111"
                         BorderThickness="0"
                         Foreground="White"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,6,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </Border>
</Window>
