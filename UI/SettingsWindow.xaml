<Window x:Class="UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Overlay Settings" 
        Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A1E">
    <Window.Resources>
        <Style x:Key="SettingGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <Style x:Key="SettingHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        
        <Style x:Key="SettingSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="TickFrequency" Value="0.05"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>
        
        <Style x:Key="SettingComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4C4C56"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    
    <Border Background="#1A1A1E" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Animations Section -->
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeaderStyle}" Text="Animations"/>
                        <CheckBox x:Name="EnableAnimationsCheck" 
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  Content="Enable smooth animations"
                                  ToolTip="Toggle fade and slide animations for scoreboard updates"/>
                        
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingLabelStyle}" Text="Hover Opacity:"/>
                            <Slider x:Name="HoverOpacitySlider" 
                                    Grid.Column="1"
                                    Style="{StaticResource SettingSliderStyle}"
                                    ValueChanged="HoverOpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="HoverOpacityLabel" Grid.Column="2" 
                                       Style="{StaticResource SettingLabelStyle}" 
                                       Width="40" Text="15%"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Performance Section -->
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeaderStyle}" Text="Performance"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingLabelStyle}" Text="Update Interval:"/>
                            <Slider x:Name="PollingIntervalSlider" 
                                    Grid.Column="1"
                                    Minimum="500" Maximum="5000" TickFrequency="250"
                                    Style="{StaticResource SettingSliderStyle}"
                                    ValueChanged="PollingIntervalSlider_ValueChanged"/>
                            <TextBlock x:Name="PollingIntervalLabel" Grid.Column="2" 
                                       Style="{StaticResource SettingLabelStyle}" 
                                       Width="60" Text="2000ms"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- System Section -->
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeaderStyle}" Text="System"/>
                        <CheckBox x:Name="AutoStartServerCheck" 
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  Content="Auto-start Node.js server"
                                  ToolTip="Automatically start the HLTV scraping server when app launches"/>
                        <CheckBox x:Name="StartOnLoginCheck" 
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  Content="Start with Windows"
                                  ToolTip="Launch CS2 Overlay when Windows starts (requires restart)"/>
                        <CheckBox x:Name="MinimizeToTrayCheck" 
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  Content="Minimize to system tray"
                                  ToolTip="Hide window to tray instead of closing"/>
                    </StackPanel>
                </Border>
                
                <!-- Theme Section -->
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeaderStyle}" Text="Appearance"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingLabelStyle}" Text="Theme:"/>
                            <ComboBox x:Name="ThemeComboBox" 
                                      Grid.Column="1"
                                      Style="{StaticResource SettingComboBoxStyle}">
                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Auto" Tag="Auto"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="ResetButton" Content="Reset to Defaults" 
                            Click="ResetButton_Click"
                            Padding="12,8" Margin="0,0,12,0"
                            Background="#4C4C56" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="SaveButton" Content="Save &amp; Close" 
                            Click="SaveButton_Click"
                            Padding="16,8" 
                            Background="#4C63FF" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>