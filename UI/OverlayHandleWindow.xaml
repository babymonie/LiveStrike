<Window x:Class="CS2Overlay.UI.OverlayHandleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Width="120" Height="36"
        ShowInTaskbar="False"
        Opacity="0.97">

    <Border CornerRadius="8"
            Background="#DD1B1B1F"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Padding="6"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.5"
                              Color="#000000"/>
        </Border.Effect>

        <DockPanel MouseLeftButtonDown="DockPanel_MouseLeftButtonDown">
            <!-- STATUS -->
            <TextBlock x:Name="StatusText"
                       Text="Unlocked"
                       Foreground="#FFFFFF"
                       FontWeight="SemiBold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"/>

            <!-- LOCK BUTTON -->
            <Button x:Name="ToggleBtn"
                    Content="🔓"
                    Width="32"
                    Height="24"
                    Margin="6,0,0,0"
                    Padding="0"
                    Background="#272730"
                    Foreground="#FFFFFF"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Toggle Lock (click-through)"
                    Click="ToggleBtn_Click"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="#333349"
                                                Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.1"
                                                 Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.1"
                                                 Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="#272730"
                                                Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </DockPanel>
    </Border>
</Window>