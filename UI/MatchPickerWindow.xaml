<Window x:Class="CS2Overlay.UI.MatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick an HLTV Match"
        Height="560" Width="880"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Loaded="Window_Loaded"
        Opacity="0">

    <Border Background="#121218"
            CornerRadius="12"
            BorderBrush="#1F1F28"
            BorderThickness="1"
            Padding="18"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.4"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- HEADER -->
                <RowDefinition Height="Auto"/>   <!-- REFRESH BAR -->
                <RowDefinition Height="*"/>      <!-- LIST -->
                <RowDefinition Height="Auto"/>   <!-- FOOTER -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Pick an HLTV Match"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn"
                        Content="✕"
                        Width="28" Height="28"
                        Background="Transparent"
                        Foreground="#999"
                        FontWeight="Bold"
                        BorderThickness="0"
                        FontSize="14"
                        DockPanel.Dock="Right"
                        Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FF4C63FF"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <!-- REFRESH BAR -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Server:" Foreground="#AAA" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="RefreshBtn"
                        Content="⟳ Refresh HLTV"
                        Click="RefreshBtn_Click"
                        Padding="12,6"
                        Background="#1E1E28"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                    To="#2A2A3C" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                    To="#1E1E28" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="#6D9EEB"
                           FontSize="13"
                           FontStyle="Italic"/>
            </StackPanel>

            <!-- MATCH LIST -->
            <Border Grid.Row="2"
                    Background="#181820"
                    CornerRadius="6"
                    BorderBrush="#252530"
                    BorderThickness="1"
                    Padding="4"
                    Margin="0,0,0,12">
                <ListView x:Name="MatchesList"
                          Background="Transparent"
                          Foreground="#EAEAEA"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Foreground" Value="#BBB"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="#1A1A24"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>

                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#202030"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2E2E4A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="Stars" Width="50" DisplayMemberBinding="{Binding Stars}"/>
                            <GridViewColumn Header="BO" Width="60" DisplayMemberBinding="{Binding Bo}"/>
                            <GridViewColumn Header="Score" Width="80" DisplayMemberBinding="{Binding ScoreNow}"/>
                            <GridViewColumn Header="Teams" Width="280" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Event" Width="220" DisplayMemberBinding="{Binding Event}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- FOOTER -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartBtn"
                        Content="▶ Start Overlay"
                        Click="StartBtn_Click"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Background="#4C63FF"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Padding="14,8"
                        Background="#2C2C3A"
                        Foreground="#CCC"
                        BorderThickness="0"
                        Cursor="Hand"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
